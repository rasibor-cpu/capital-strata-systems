{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "css.mi_ext_001.external_event.v1",
  "title": "MI-EXT-001 External Event Provenance Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source_id",
    "source_name",
    "source_tier",
    "source_url",
    "publisher",
    "jurisdiction",
    "published_at",
    "retrieved_at",
    "effective_at",
    "title",
    "normalized_summary",
    "event_category",
    "affected_instruments",
    "affected_asset_classes",
    "raw_content_hash",
    "normalized_content_hash",
    "parser_version",
    "schema_version",
    "confidence",
    "verification_status",
    "corroborating_source_ids",
    "contradiction_status",
    "freshness_status",
    "licensing_usage_classification",
    "advisory_only",
    "execution_allowed"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "source_name": { "type": "string", "minLength": 1 },
    "source_tier": {
      "type": "string",
      "enum": [
        "TIER_1_OFFICIAL_PRIMARY",
        "TIER_2_VERIFIED_INSTITUTIONAL",
        "TIER_3_SECONDARY_NEWS",
        "TIER_4_UNVERIFIED_SOCIAL",
        "UNKNOWN"
      ]
    },
    "source_url": { "type": "string" },
    "publisher": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "published_at": { "type": "string", "description": "ISO-8601 or UNAVAILABLE/UNKNOWN — never invent" },
    "retrieved_at": { "type": "string" },
    "effective_at": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "normalized_summary": { "type": "string" },
    "event_category": { "type": "string" },
    "affected_instruments": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Empty when unknown — do not invent"
    },
    "affected_asset_classes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "raw_content_hash": { "type": "string" },
    "normalized_content_hash": { "type": "string" },
    "parser_version": { "type": "string" },
    "schema_version": { "const": "css.mi_ext_001.external_event.v1" },
    "confidence": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "string", "enum": ["UNKNOWN", "UNAVAILABLE"] },
        { "type": "null" }
      ]
    },
    "verification_status": { "type": "string" },
    "corroborating_source_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contradiction_status": {
      "type": "string",
      "enum": ["NONE", "CONFLICT", "UNRESOLVED_TIER1_CONFLICT", "UNKNOWN"]
    },
    "freshness_status": {
      "type": "string",
      "enum": ["FRESH", "AGING", "STALE", "EXPIRED", "UNKNOWN"]
    },
    "licensing_usage_classification": { "type": "string" },
    "advisory_only": { "const": true },
    "execution_allowed": { "const": false },
    "primary_source_id": { "type": ["string", "null"] },
    "conflicting_source_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "duplicate_count": { "type": "integer", "minimum": 1 },
    "first_seen": { "type": "string" },
    "last_updated": { "type": "string" },
    "canonical_event_hash": { "type": "string" },
    "impact_direction": { "type": "string" },
    "impact_magnitude": { "type": "string" },
    "impact_horizon": { "type": "string" },
    "impact_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "counter_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "data_completeness": { "type": "string" }
  }
}
