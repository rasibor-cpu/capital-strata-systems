  {
   "id": "knowledge_core",
   "kind": "question",
   "group": "Knowledge",
   "title": "Orders and sizing",
   "questions": [
    {
     "id": "kq_market_vs_limit",
     "type": "quiz",
     "topic": "order_types",
     "prompt": "What does a limit order do?",
     "required": true,
     "options": [
      {
       "value": "a",
       "label": "Fills immediately at whatever the market price is"
      },
      {
       "value": "b",
       "label": "Fills only at your chosen price or better"
      },
      {
       "value": "c",
       "label": "Closes a trade automatically after a loss"
      },
      {
       "value": "not_sure",
       "label": "I'm not sure yet"
      }
     ],
     "correct": "b",
     "explain": "A limit order sets the worst price you accept. It may not fill at all."
    },
    {
     "id": "kq_stop",
     "type": "quiz",
     "topic": "stop_orders",
     "prompt": "A stop-loss order is mainly used to…",
     "required": true,
     "options": [
      {
       "value": "a",
       "label": "Guarantee the exit price"
      },
      {
       "value": "b",
       "label": "Limit a loss by exiting once a price is reached"
      },
      {
       "value": "c",
       "label": "Increase position size when price falls"
      },
      {
       "value": "not_sure",
       "label": "I'm not sure yet"
      }
     ],
     "correct": "b",
     "explain": "A stop triggers an exit at a level you set. In fast markets the fill can be worse than the stop price."
    },
    {
     "id": "kq_position_size",
     "type": "quiz",
     "topic": "position_sizing",
     "prompt": "With a $10,000 account and a 1% risk rule, the most you plan to lose on one trade is…",
     "required": true,
     "options": [
      {
       "value": "a",
       "label": "$10"
      },
      {
       "value": "b",
       "label": "$100"
      },
      {
       "value": "c",
       "label": "$1,000"
      },
      {
       "value": "not_sure",
       "label": "I'm not sure yet"
      }
     ],
     "correct": "b",
     "explain": "1% of $10,000 is $100. Position size is then set so that hitting your stop loses about that much."
    },
    {
     "id": "kq_risk_reward",
     "type": "quiz",
     "topic": "risk_reward",
     "prompt": "A trade risks $50 to make $150. Its reward-to-risk ratio is…",
     "required": true,
     "options": [
      {
       "value": "a",
       "label": "1 : 3"
      },
      {
       "value": "b",
       "label": "3 : 1"
      },
      {
       "value": "c",
       "label": "It depends on the win rate only"
      },
      {
       "value": "not_sure",
       "label": "I'm not sure yet"
      }
     ],
     "correct": "b",
     "explain": "$150 ÷ $50 = 3. A good ratio still needs a sensible win rate to pay off over time."
    }
   ]
  },
  {
   "id": "knowledge_risk",
   "kind": "question",
   "group": "Knowledge",
   "title": "Volatility, drawdown and diversification",
   "questions": [
    {
     "id": "kq_volatility",
     "type": "quiz",
     "topic": "volatility",
     "prompt": "Higher volatility usually means…",
     "required": true,
     "options": [
      {
       "value": "a",
       "label": "Larger and faster price swings, up and down"
      },
      {
       "value": "b",
       "label": "Prices only go up"
      },
      {
       "value": "c",
       "label": "Less risk"
      },
      {
       "value": "not_sure",
       "label": "I'm not sure yet"
      }
     ],
     "correct": "a",
     "explain": "Volatility measures how widely prices move. It widens both gains and losses."
    },
    {
     "id": "kq_drawdown",
     "type": "quiz",
     "topic": "drawdown",
     "prompt": "An account falls from $12,000 to $9,000 before recovering. The drawdown was…",
     "required": true,
     "options": [
      {
       "value": "a",
       "label": "$9,000"
      },
      {
       "value": "b",
       "label": "25%"
      },
      {
       "value": "c",
       "label": "75%"
      },
      {
       "value": "not_sure",
       "label": "I'm not sure yet"
      }
     ],
     "correct": "b",
     "explain": "Drawdown is the fall from a peak: $3,000 ÷ $12,000 = 25%."
    },
    {
     "id": "kq_diversification",
     "type": "quiz",
     "topic": "diversification",
     "prompt": "Diversification aims to…",
     "required": true,
     "options": [
      {
       "value": "a",
       "label": "Remove all risk"
      },
      {
       "value": "b",
       "label": "Reduce the impact of any single position going wrong"
      },
      {
       "value": "c",
       "label": "Guarantee higher returns"
      },
      {
       "value": "not_sure",
       "label": "I'm not sure yet"
      }
     ],
     "correct": "b",
     "explain": "Spreading exposure lowers the damage one position can do. It cannot remove market-wide risk."
    },
    {
     "id": "kq_exposure",
     "type": "quiz",
     "topic": "portfolio_exposure",
     "prompt": "You hold three different tech stocks, each 20% of your account. Your exposure to the tech sector is…",
     "required": true,
     "options": [
      {
       "value": "a",
       "label": "About 20%"
      },
      {
       "value": "b",
       "label": "About 60%"
      },
      {
       "value": "c",
       "label": "Unknown without prices"
      },
      {
       "value": "not_sure",
       "label": "I'm not sure yet"
      }
     ],
     "correct": "b",
     "explain": "Three positions in one sector add up: 3 × 20% = 60% exposure to that sector."
    }
   ]
