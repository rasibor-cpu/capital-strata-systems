# ============================
# REA Capital — FX Data Feeds
# ============================

# Choose provider:
#   oanda | polygon | alphavantage | replay | composite
FX_PROVIDER=oanda

# Choose fallback provider (used only when FX_PROVIDER=composite)
FX_FALLBACK_PROVIDER=replay

# Instrument examples:
#   EUR_USD, GBP_USD, USD_JPY (OANDA format)
#   C:EURUSD (Polygon FX format - may vary)
FX_INSTRUMENT=EUR_USD

# Bar timeframe (we start with 1-minute bars)
FX_TIMEFRAME=1m

# ============================
# OANDA (recommended first)
# ============================
OANDA_ENV=practice
OANDA_API_TOKEN=PASTE_TOKEN_HERE
OANDA_ACCOUNT_ID=PASTE_ACCOUNT_ID_HERE

# ============================
# POLYGON (optional)
# ============================
POLYGON_API_KEY=PASTE_KEY_HERE

# ============================
# ALPHAVANTAGE (optional)
# ============================
ALPHAVANTAGE_API_KEY=PASTE_KEY_HERE

# ============================
# REPLAY (CSV live-like testing)
# ============================
REPLAY_CSV_PATH=sample_eurusd_1m.csv
REPLAY_SPEED=1.0
# REPLAY_SPEED=1.0 means real-time-ish pacing (1 bar per minute simulation)
# You can set REPLAY_SPEED=20 for faster tests