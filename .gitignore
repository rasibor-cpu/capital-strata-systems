# ================================
# CSS Canonical .gitignore
# PCNRASS Governance Protected
# ================================

# --- Environment / secrets ---
.env
.env.*
!.env.example
keys/
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.secret
*.env
*.token
*.tokens
*.credential
*.credentials
*token*.json
*tokens*.json
*secret*.json
*credential*.json
*credentials*.json
cdp_api_key*.json

# --- Python cache ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Virtual environments ---
venv/
.venv/
env/
.env/

# --- Runtime outputs / logs ---
*.log
*.jsonl
audit_logs/
audit/
state/
runtime/
reporting_store/
out/
feeds/
data_fx/
live_tick_*.json
runlog.txt

# --- Governance generated reports ---
governance/reports/

# --- Archives / recovery snapshots ---
archive/
*_before_*.py
*_backup*.py
*_PRE_*.py
*_pre_*.py

# --- Local data / generated datasets ---
data/
*.csv

# --- Scratch / temporary files ---
_find_*.txt
_find_csv.cmd
analysis/
str/

# --- Experimental / one-off scripts ---
test_*.py
run_live_*.py
run_fx_pairs_replay_*_fxrulesless_*.py

# --- OS files ---
.DS_Store
Thumbs.db

# ================================
# Explicitly tracked governance/runtime code
# ================================

!engine/
!engine/execution/
!engine/execution_firewall.py
!engine/execution_router.py
!engine/execution_decision.py
!engine/adapters/regime_gate_adapter.py
!engine/test_execution_decision_runner.py
!engine/execution/execution_gate.py

!live_data/
!live_data/*.py
live_data/__pycache__/
live_data/**/*.log
# --- Runtime artifacts ---
artifacts/
data_cache/
data_store/
backend/app/futures_exposure.json
