# ============================================================
# CAPITAL STRATA SYSTEMS – INSTITUTIONAL .gitignore
# ============================================================

# ----------------------------
# Python Artifacts
# ----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.cpython-*

# ----------------------------
# Virtual Environments
# ----------------------------
.env
.env.*
venv/
.venv/
env/

# ----------------------------
# Runtime / Audit Artifacts
# ----------------------------
audit/
audit_logs/
state/
runtime/
reporting_store/
*.log
*.jsonl
runlog.txt
live_tick_*.json

# ----------------------------
# Local Data (Never Commit)
# ----------------------------
data/
*.csv

# ----------------------------
# OS Files
# ----------------------------
.DS_Store
Thumbs.db

# ----------------------------
# Temporary / Scratch
# ----------------------------
analysis/
*_find_*.txt
_find_*.cmd

# ----------------------------
# IDE / Editor
# ----------------------------
.vscode/
.idea/

# ----------------------------
# Safety: Never ignore core engine
# ----------------------------
!engine/
!backend/
!tools/
coinbase_key.json
coinbase_private_key.pem
.env
keys/