# =========================
# REA Capital – Git Ignore
# =========================

# ---- Runtime / audit artifacts ----
audit_logs/
*.log
*.jsonl

# ---- Python cache ----
__pycache__/
*.py[cod]
*$py.class

# ---- Virtual environments ----
.venv/
venv/
ENV/
env/

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.tmp
*.bak

# ---- IDEs ----
.vscode/
.idea/

# ---- Data & outputs (generated) ----
last_prompt.json
*.csv~
*.csv.bak

# ---- Security / secrets (never commit) ----
.env
.env.*
*.key
*.pem

# ---- Misc ----
coverage/
dist/
build/