# CSS RC-002B — Certified Paper Trading Environment Profile (EXAMPLE)
# Copy to .env.paper for local use. NEVER commit real secrets.
# Activate via: CSS_BROKER_ENVIRONMENT_PROFILE=PAPER
#
# Constraints:
# - non-production
# - paper / practice execution posture only
# - live execution blocked
# - broker live-order flags false
# - fail-closed defaults preserved
# - no OV-002 / production / live authorization

# --- Profile selection ---
CSS_BROKER_ENVIRONMENT_PROFILE=PAPER
BROKER_ENVIRONMENT_PROFILE=PAPER

# --- Runtime / execution posture ---
CSS_ENV=paper
DEFAULT_EXECUTION_MODE=paper
ALLOW_LIVE_TRADING=false
ENABLE_LIVE_TRADING=false
CSS_ENABLE_LIVE_TRADING=false
CSS_LIVE_ORDER_KILL_SWITCH=1

# --- Risk / gates (keep enabled) ---
ENABLE_RISK_GOVERNOR=true
ENABLE_EXECUTION_GATES=true
ENABLE_AUDIT_LOGGING=true

# --- Coinbase (paper-safe; no live orders) ---
COINBASE_ENABLED=false
COINBASE_ENABLE_LIVE_ORDERS=false
COINBASE_ENABLE_LIVE_TRADING=false
# Optional paper notional only (never use in live profiles):
# COINBASE_TEST_ORDER_USD=1.00

# --- OANDA (practice only) ---
OANDA_ENABLED=false
OANDA_ENV=practice
OANDA_ENABLE_LIVE_ORDERS=false
OANDA_ENABLE_LIVE_TRADING=false

# --- Mission Control / dashboard (local) ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
LOG_LEVEL=INFO

# Do NOT set live arm / confirm phrases in this profile:
# REA_LIVE_ARM / REA_CONFIRM_LIVE must remain unset or false.

# --- Read-only market data (closeout; backend/signals/market_data.py) ---
# Jurisdiction the platform operates from (ISO 3166-1 alpha-2). Required for Binance public data;
# Binance.com does not serve CA or US, so with CA the Binance provider is BLOCKED by design.
CSS_OPERATING_COUNTRY=CA
# Coinbase Exchange public candles/book and Alpaca crypto public bars need NO credentials.
# Alpaca US equities (free IEX feed; INDICATIVE, not the consolidated tape) — leave blank unless issued:
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# OANDA v20 PRACTICE token for FX candles (the live host is refused in code):
OANDA_PRACTICE_TOKEN=
# Options / futures: no authorized feed exists; those providers always report BLOCKED.
# Optional tighten-only position limits (values above the governed 10 / 2 are ignored):
# CSS_MAX_TOTAL_OPEN_POSITIONS=10
# CSS_MAX_NEW_POSITIONS_PER_CYCLE=2
