# CSS RC-002B — Certified Paper Trading Environment Profile (EXAMPLE)
# Copy to .env.paper for local use. NEVER commit real secrets.
# Activate via: CSS_BROKER_ENVIRONMENT_PROFILE=PAPER
#
# Constraints:
# - non-production
# - paper / practice execution posture only
# - live execution blocked
# - broker live-order flags false
# - fail-closed defaults preserved
# - no OV-002 / production / live authorization

# --- Profile selection ---
CSS_BROKER_ENVIRONMENT_PROFILE=PAPER
BROKER_ENVIRONMENT_PROFILE=PAPER

# --- Runtime / execution posture ---
CSS_ENV=paper
DEFAULT_EXECUTION_MODE=paper
ALLOW_LIVE_TRADING=false
ENABLE_LIVE_TRADING=false
CSS_ENABLE_LIVE_TRADING=false
CSS_LIVE_ORDER_KILL_SWITCH=1

# --- Risk / gates (keep enabled) ---
ENABLE_RISK_GOVERNOR=true
ENABLE_EXECUTION_GATES=true
ENABLE_AUDIT_LOGGING=true

# --- Coinbase (paper-safe; no live orders) ---
COINBASE_ENABLED=false
COINBASE_ENABLE_LIVE_ORDERS=false
COINBASE_ENABLE_LIVE_TRADING=false
# Optional paper notional only (never use in live profiles):
# COINBASE_TEST_ORDER_USD=1.00

# --- OANDA (practice only) ---
OANDA_ENABLED=false
OANDA_ENV=practice
OANDA_ENABLE_LIVE_ORDERS=false
OANDA_ENABLE_LIVE_TRADING=false

# --- Mission Control / dashboard (local) ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
LOG_LEVEL=INFO

# Do NOT set live arm / confirm phrases in this profile:
# REA_LIVE_ARM / REA_CONFIRM_LIVE must remain unset or false.
